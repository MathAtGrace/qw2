get_first_table <- function(page_w_meta){
meta <- page_w_meta[[1]]
page <- page_w_meta[[2]]
table_data <- page |>
html_element("table") |>
html_table()  |>
as.data.frame() |>
janitor::clean_names() |>
mutate(max_winds_kt = as.numeric(gsub("[^0-9.]", "", max_winds_kt)),
